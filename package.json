{
  "name": "agroed",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agroed/web dev",
    "build": "pnpm --filter @agroed/web build",
    "generate": "pnpm --filter @agroed/web generate",
    "preview": "pnpm --filter @agroed/web preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter @agroed/web typecheck",
    "test": "pnpm --filter @agroed/web test",
    "seo:audit": "node scripts/seo-audit.mjs",
    "test:e2e": "pnpm --filter @agroed/web test:e2e",
    "env:init": "node scripts/env-init.mjs",
    "db:up": "docker compose up -d db --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db sh -c \"psql -U $POSTGRES_USER -d $POSTGRES_DB\"",
    "db:backup": "node scripts/db.mjs backup",
    "db:restore": "node scripts/db.mjs restore",
    "db:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "node-html-parser": "^9.0.6"
  }
}
